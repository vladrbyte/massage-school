---
// Плейсхолдер для фото/видео. Позже заменяется на <Image> или <video>
// с теми же размерами, поэтому вёрстка не поедет.
interface Props {
  label: string;
  kind?: "photo" | "video";
  class?: string;
}

const { label, kind = "photo", class: className } = Astro.props;
---

<div class:list={["placeholder", className]} role="img" aria-label={label}>
  <div class="placeholder__inner">
    {kind === "video" ? (
      <svg viewBox="0 0 24 24" width="34" height="34" aria-hidden="true">
        <circle cx="12" cy="12" r="11" fill="none" stroke="currentColor" stroke-width="1" />
        <path d="M10 8.5v7l5.5-3.5z" fill="currentColor" />
      </svg>
    ) : (
      <svg viewBox="0 0 24 24" width="34" height="34" aria-hidden="true">
        <rect x="2.5" y="5" width="19" height="14" rx="2.5" fill="none" stroke="currentColor" stroke-width="1" />
        <circle cx="12" cy="12" r="3.5" fill="none" stroke="currentColor" stroke-width="1" />
        <path d="M8 5l1.5-2h5L16 5" fill="none" stroke="currentColor" stroke-width="1" />
      </svg>
    )}
    <span>{label}</span>
  </div>
</div>

<style>
  .placeholder {
    position: relative;
    display: grid;
    place-items: center;
    overflow: hidden;
    background:
      radial-gradient(120% 80% at 20% 10%, #f3e9d6 0%, transparent 60%),
      radial-gradient(90% 70% at 90% 100%, #dfe3d2 0%, transparent 65%),
      var(--color-surface-2);
    color: var(--color-brown);
  }

  .placeholder::after {
    /* лёгкая "ткань", чтобы блок не выглядел пустым */
    content: "";
    position: absolute;
    inset: 0;
    background-image: repeating-linear-gradient(
      135deg,
      rgb(117 86 55 / 0.035) 0 1px,
      transparent 1px 14px
    );
    pointer-events: none;
  }

  .placeholder__inner {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: center;
    gap: 0.6rem;
    max-width: 22ch;
    padding: 1rem;
    text-align: center;
    font-size: var(--fs-sm);
    line-height: 1.4;
    opacity: 0.75;
  }
</style>
