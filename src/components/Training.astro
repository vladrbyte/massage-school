---
import { getContent } from "../i18n";
import SectionHeader from "./SectionHeader.astro";
import MediaPlaceholder from "./MediaPlaceholder.astro";

const { training } = getContent(Astro.url);
const { about, formats } = training;

const icons: Record<string, string> = {
  online:
    '<rect x="3" y="4.5" width="18" height="12" rx="2"/><path d="M8.5 20h7M12 16.5V20"/>',
  studio:
    '<path d="M12 4c2.2 2.6 2.2 5.8 0 9-2.2-3.2-2.2-6.4 0-9z"/><path d="M4.5 9.5c3 .3 5.6 2.4 7.5 5.5-3.8.8-6.7-1.2-7.5-5.5zM19.5 9.5c-.8 4.3-3.7 6.3-7.5 5.5 1.9-3.1 4.5-5.2 7.5-5.5z"/><path d="M5 19.5h14"/>',
  mixed: '<circle cx="9" cy="12" r="5.5"/><circle cx="15" cy="12" r="5.5"/>',
};
---

<section class="section training" id="ausbildung" aria-labelledby="ausbildung-title">
  <div class="container">
    <div class="training__intro">
      <div>
        <SectionHeader id="ausbildung-title" eyebrow={about.eyebrow} title={about.title} lead={about.lead} />

        <div class="extras" data-reveal>
          <h3 class="extras__title">{about.extras.title}</h3>
          <ul class="leaf-list">
            {about.extras.items.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>

      <div class="training__media" data-reveal style="--reveal-delay: .1s">
        <MediaPlaceholder class="training__photo" label={about.media} />
      </div>
    </div>

    <h3 class="formats__title" data-reveal>{formats.title}</h3>
    <div class="formats">
      {formats.items.map((item, i) => (
        <article
          class:list={["format", { "format--highlight": item.highlight }]}
          data-reveal
          style={`--reveal-delay: ${i * 0.08}s`}
        >
          <span class="format__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" set:html={icons[item.icon]} />
          </span>
          <h4 class="format__name">{item.name}</h4>
          <p class="format__text">{item.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .training__intro {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: center;
  }

  .extras {
    padding: var(--space-5) var(--space-6);
    border-left: 2px solid var(--color-gold);
    background: linear-gradient(90deg, var(--color-surface), transparent);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
  }

  .extras__title {
    margin-bottom: var(--space-4);
    font-size: 1.5rem;
  }

  .training__media :global(.training__photo) {
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-lg) var(--radius-lg) var(--radius-lg) 160px;
    box-shadow: var(--shadow-card);
  }

  .formats__title {
    margin: clamp(3.5rem, 2.5rem + 4vw, 6rem) 0 var(--space-6);
    font-size: var(--fs-h3);
  }

  .formats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
  }

  .format {
    display: grid;
    align-content: start;
    gap: var(--space-3);
    padding: var(--space-6);
    background: #fff;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    transition: transform 0.4s var(--ease), box-shadow 0.4s var(--ease), border-color 0.4s var(--ease);
  }

  .format:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-card);
    border-color: var(--color-gold);
  }

  .format--highlight {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: #f4f1e8;
  }

  .format--highlight .format__name { color: #fff; }
  .format--highlight .format__icon { background: rgb(255 255 255 / 0.12); color: #fff; }
  .format--highlight .format__text { color: rgb(255 255 255 / 0.85); }

  .format__icon {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--color-surface);
    color: var(--color-sage);
    margin-bottom: var(--space-2);
  }

  .format__name {
    font-size: 1.7rem;
  }

  .format__text {
    color: var(--color-text-muted);
  }

  @media (max-width: 900px) {
    .training__intro { grid-template-columns: 1fr; }
    .training__media { max-width: 460px; }
    .formats { grid-template-columns: 1fr; }
  }
</style>
