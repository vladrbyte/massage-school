---
interface Props {
  id: string;
  eyebrow: string;
  title: string;
  lead?: string;
  align?: "left" | "center";
}

const { id, eyebrow, title, lead, align = "left" } = Astro.props;
---

<header class:list={["section-header", `section-header--${align}`]} data-reveal>
  <p class="eyebrow">{eyebrow}</p>
  <h2 id={id}>{title}</h2>
  {lead && <p class="lead">{lead}</p>}
</header>

<style>
  .section-header {
    display: grid;
    gap: var(--space-4);
    max-width: 42rem;
    margin-bottom: clamp(2rem, 1.5rem + 2vw, 3.5rem);
  }

  .section-header--center {
    margin-inline: auto;
    text-align: center;
    justify-items: center;
  }

  .section-header--center .lead {
    margin-inline: auto;
  }
</style>
