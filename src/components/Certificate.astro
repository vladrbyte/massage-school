---
import { getContent, withBase } from "../i18n";

const { training, site } = getContent(Astro.url);
const { certificate } = training;
---

<section class="section certificate" aria-labelledby="zertifikat-title">
  <div class="container certificate__grid">
    <div class="doc-wrap" data-reveal aria-hidden="true">
      <div class="doc">
        <img class="doc__logo" src={withBase("/media/logo-mark.png")} alt="" width="420" height="290" />
        <span class="doc__line doc__line--title"></span>
        <span class="doc__line"></span>
        <span class="doc__line doc__line--short"></span>
        <span class="doc__badge">{site.ui.certNote}</span>
        <span class="doc__sign"></span>
      </div>
    </div>

    <div class="certificate__text">
      <p class="eyebrow" data-reveal>{certificate.eyebrow}</p>
      <h2 id="zertifikat-title" data-reveal>{certificate.title}</h2>
      <p class="lead" data-reveal>{certificate.text}</p>

      <h3 class="careers__title" data-reveal>{certificate.careersTitle}</h3>
      <ul class="careers" data-reveal>
        {certificate.careers.map((c) => <li>{c}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .certificate__grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: center;
  }

  .doc-wrap {
    display: grid;
    place-items: center;
    padding: var(--space-6);
  }

  .doc {
    position: relative;
    display: grid;
    justify-items: center;
    gap: var(--space-3);
    width: min(300px, 100%);
    aspect-ratio: 1 / 1.414;
    padding: 12% 12% 10%;
    background: var(--color-bg);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-sm);
    box-shadow:
      12px 10px 0 -1px var(--color-surface-2),
      12px 10px 0 0 var(--color-line),
      var(--shadow-card);
    transform: rotate(-3deg);
  }

  .doc__logo { width: 38%; margin-bottom: var(--space-2); }

  .doc__line {
    width: 80%;
    height: 6px;
    border-radius: 3px;
    background: var(--color-surface-2);
  }

  .doc__line--title {
    width: 90%;
    height: 10px;
    background: var(--color-sage);
    opacity: 0.55;
  }

  .doc__line--short { width: 55%; }

  .doc__badge {
    margin-top: var(--space-3);
    padding: 0.25rem 0.7rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-align: center;
    color: var(--color-text-muted);
  }

  .doc__sign {
    align-self: end;
    justify-self: end;
    width: 40%;
    height: 1px;
    background: var(--color-text-muted);
    opacity: 0.5;
  }

  .certificate__text {
    display: grid;
    gap: var(--space-4);
  }

  .certificate__note {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
    padding: var(--space-4) var(--space-5);
    border-left: 2px solid var(--color-gold);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    background: var(--color-surface);
    font-size: 0.95rem;
    color: var(--color-text);
  }

  .certificate__note svg {
    flex-shrink: 0;
    margin-top: 2px;
    color: var(--color-gold);
  }

  .careers__title {
    margin-top: var(--space-4);
    font-size: 1.5rem;
  }

  .careers {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .careers li {
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
    background: #fff;
    font-size: 0.95rem;
  }

  @media (max-width: 800px) {
    .certificate__grid { grid-template-columns: 1fr; }
    .doc { width: min(220px, 70%); }
  }
</style>
