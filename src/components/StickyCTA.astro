---
// Закреплённые кнопки "Позвонить" и "WhatsApp" на телефоне.
// Появляются после первого экрана и прячутся у формы контактов.
import { getContent } from "../i18n";

const { site } = getContent(Astro.url);
const { contact, sticky } = site;
---

<div class="sticky-cta" data-sticky-cta aria-hidden="true">
  <a class="sticky-cta__btn" href={contact.phoneHref} tabindex="-1">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4h3.5l1.5 4-2 1.5a11 11 0 0 0 6.5 6.5L16 14l4 1.5V19a1.5 1.5 0 0 1-1.6 1.5A16 16 0 0 1 3.5 5.6 1.5 1.5 0 0 1 5 4z"/></svg>
    {sticky.call}
  </a>
  <a class="sticky-cta__btn sticky-cta__btn--primary" href={contact.whatsapp} target="_blank" rel="noopener" tabindex="-1">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20l1.3-3.8A8 8 0 1 1 8 19z"/></svg>
    {sticky.whatsapp}
  </a>
</div>

<script>
  const bar = document.querySelector<HTMLElement>("[data-sticky-cta]");
  const hero = document.querySelector(".hero");
  const contact = document.querySelector("#kontakt");

  if (bar && hero && "IntersectionObserver" in window) {
    let pastHero = false;
    let atContact = false;

    const update = () => {
      const visible = pastHero && !atContact;
      bar.classList.toggle("is-visible", visible);
      bar.setAttribute("aria-hidden", String(!visible));
      bar.querySelectorAll("a").forEach((a) => (a.tabIndex = visible ? 0 : -1));
    };

    new IntersectionObserver(([e]) => {
      pastHero = !e.isIntersecting;
      update();
    }).observe(hero);

    if (contact) {
      new IntersectionObserver(([e]) => {
        atContact = e.isIntersecting;
        update();
      }).observe(contact);
    }
  }
</script>

<style>
  .sticky-cta {
    display: none;
  }

  @media (max-width: 720px) {
    .sticky-cta {
      position: fixed;
      left: 12px;
      right: 12px;
      bottom: calc(12px + env(safe-area-inset-bottom));
      z-index: 40;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
      padding: 8px;
      background: rgb(255 252 245 / 0.94);
      backdrop-filter: blur(8px);
      border: 1px solid var(--color-line);
      border-radius: var(--radius-pill);
      box-shadow: 0 12px 30px -10px rgb(117 86 55 / 0.35);
      transform: translateY(140%);
      transition: transform 0.4s var(--ease);
    }

    .sticky-cta.is-visible { transform: none; }
  }

  .sticky-cta__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 46px;
    border-radius: var(--radius-pill);
    font-weight: 600;
    text-decoration: none;
    color: var(--color-brown);
    border: 1px solid var(--color-line);
  }

  .sticky-cta__btn--primary {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: #fff;
  }
</style>
