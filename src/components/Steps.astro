---
import { getContent } from "../i18n";
import SectionHeader from "./SectionHeader.astro";

const { training } = getContent(Astro.url);
const { steps } = training;
---

<section class="section section--soft steps" id="ablauf" aria-labelledby="ablauf-title">
  <div class="container">
    <SectionHeader id="ablauf-title" eyebrow={steps.eyebrow} title={steps.title} align="center" />

    <ol class="step-list">
      {steps.items.map((step, i) => (
        <li class="step" data-reveal style={`--reveal-delay: ${i * 0.12}s`}>
          <span class="step__num" aria-hidden="true">{i + 1}</span>
          <h3 class="step__title">{step.title}</h3>
          <p class="step__text">{step.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .step-list {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: none;
  }

  .step-list::before {
    /* тонкая золотая линия, соединяющая шаги */
    content: "";
    position: absolute;
    top: 36px;
    left: calc(100% / 6);
    right: calc(100% / 6);
    height: 1px;
    background: repeating-linear-gradient(90deg, var(--color-gold) 0 6px, transparent 6px 12px);
    opacity: 0.7;
  }

  .step {
    position: relative;
    display: grid;
    justify-items: center;
    gap: var(--space-3);
    text-align: center;
  }

  .step__num {
    display: grid;
    place-items: center;
    width: 72px;
    height: 72px;
    margin-bottom: var(--space-3);
    border-radius: 50%;
    background: var(--color-bg);
    border: 1px solid var(--color-gold);
    box-shadow: 0 0 0 8px var(--color-surface);
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 600;
    font-variant-numeric: lining-nums;
    color: var(--color-brown);
  }

  .step__title {
    font-size: 1.8rem;
  }

  .step__text {
    max-width: 28ch;
    color: var(--color-text-muted);
  }

  @media (max-width: 800px) {
    .step-list {
      grid-template-columns: 1fr;
      gap: var(--space-7);
    }

    .step-list::before {
      top: 36px;
      bottom: 36px;
      left: 36px;
      right: auto;
      width: 1px;
      height: auto;
      background: repeating-linear-gradient(180deg, var(--color-gold) 0 6px, transparent 6px 12px);
    }

    .step {
      grid-template-columns: 72px 1fr;
      justify-items: start;
      align-items: center;
      column-gap: var(--space-5);
      text-align: left;
    }

    .step__num {
      grid-row: span 2;
      margin-bottom: 0;
      align-self: start;
    }

    .step__text { max-width: none; }
  }
</style>
