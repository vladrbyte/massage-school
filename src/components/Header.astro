---
import { getContent, getLang, langHome, withBase } from "../i18n";

const { site } = getContent(Astro.url);
const lang = getLang(Astro.url);
const { brand, nav, cta, ui } = site;
const langs = [
  { code: "de", label: "DE", href: langHome.de },
  { code: "ru", label: "RU", href: langHome.ru },
] as const;
---

<header class="header" data-header>
  <div class="container header__bar">
    <button
      class="burger"
      type="button"
      aria-controls="site-nav"
      aria-expanded="false"
      data-nav-toggle
    >
      <span class="visually-hidden">{ui.menuOpen}</span>
      <span class="burger__line burger__line--top"></span>
      <span class="burger__line burger__line--bottom"></span>
    </button>

    <a class="brand" href={withBase(ui.home)} aria-label={`${brand.name} – ${ui.homeLabel}`}>
      <img
        class="brand__mark"
        src={withBase("/media/logo-mark.png")}
        alt=""
        width="420"
        height="290"
      />
      <span class="brand__text">
        <span class="brand__name">{brand.name}</span>
        <span class="brand__tagline">{brand.tagline}</span>
      </span>
    </a>

    <div class="header__actions">
      <div class="lang" aria-label={ui.language}>
        {langs.map((l, i) => (
          <>
            {i > 0 && <span class="lang__sep" aria-hidden="true">/</span>}
            <a class:list={["lang__item", { "is-active": l.code === lang }]} href={l.href} hreflang={l.code} aria-current={l.code === lang ? "true" : undefined}>{l.label}</a>
          </>
        ))}
      </div>
      <a class="btn btn--primary btn--sm header__cta" href={withBase(`${ui.home}#kontakt`)}>{cta.header}</a>
    </div>
  </div>

  <div class="nav-backdrop" data-nav-backdrop hidden></div>

  <nav class="nav" id="site-nav" data-nav aria-label={ui.mainNav}>
    <ul class="nav__list">
      {nav.map((item) => (
        <li><a class="nav__link" href={withBase(item.href)}>{item.label}</a></li>
      ))}
    </ul>
    <a class="btn btn--primary nav__cta" href={withBase(`${ui.home}#kontakt`)}>{cta.header}</a>
  </nav>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]");
  const toggle = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
  const nav = document.querySelector<HTMLElement>("[data-nav]");
  const backdrop = document.querySelector<HTMLElement>("[data-nav-backdrop]");

  function setOpen(open: boolean) {
    toggle?.setAttribute("aria-expanded", String(open));
    nav?.classList.toggle("is-open", open);
    if (backdrop) {
      if (open) backdrop.hidden = false;
      requestAnimationFrame(() => backdrop.classList.toggle("is-visible", open));
      if (!open) setTimeout(() => (backdrop.hidden = true), 300);
    }
    document.documentElement.classList.toggle("nav-locked", open);
  }

  toggle?.addEventListener("click", () => {
    setOpen(toggle.getAttribute("aria-expanded") !== "true");
  });

  backdrop?.addEventListener("click", () => setOpen(false));

  nav?.querySelectorAll("a").forEach((link) =>
    link.addEventListener("click", () => setOpen(false))
  );

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setOpen(false);
  });

  const onScroll = () => header?.classList.toggle("is-scrolled", window.scrollY > 8);
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-bg);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s var(--ease), box-shadow 0.3s var(--ease);
  }

  .header.is-scrolled {
    border-bottom-color: var(--color-line);
    box-shadow: 0 6px 24px -18px rgb(117 86 55 / 0.45);
  }

  .header__bar {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: var(--space-4);
    height: var(--header-h);
    background: var(--color-bg);
  }

  .burger {
    position: relative;
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border: 1px solid var(--color-line);
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
    transition: border-color 0.3s var(--ease);
  }

  .burger:hover { border-color: var(--color-gold); }

  .burger__line {
    position: absolute;
    left: 13px;
    right: 13px;
    height: 1.5px;
    background: var(--color-brown);
    transition: transform 0.3s var(--ease), top 0.3s var(--ease);
  }

  .burger__line--top { top: 17px; }
  .burger__line--bottom { top: 25px; }

  .burger[aria-expanded="true"] .burger__line--top { top: 21px; transform: rotate(45deg); }
  .burger[aria-expanded="true"] .burger__line--bottom { top: 21px; transform: rotate(-45deg); }

  .brand {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-right: auto;
    text-decoration: none;
    min-width: 0;
  }

  .brand__mark {
    width: 54px;
    height: auto;
    flex-shrink: 0;
  }

  .brand__text {
    display: grid;
    line-height: 1.1;
    min-width: 0;
  }

  .brand__name {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--color-brown);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .brand__tagline {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-sage);
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .header__cta { white-space: nowrap; }

  .lang {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: var(--fs-sm);
    font-weight: 600;
  }

  .lang__item {
    padding: 0.5rem 0.15rem;
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .lang__item:hover { color: var(--color-accent); }
  .lang__item.is-active { color: var(--color-brown); }
  .lang__sep { color: var(--color-line); }

  .nav {
    position: fixed;
    top: var(--header-h);
    left: 0;
    bottom: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    width: min(380px, 100%);
    padding: var(--space-5) var(--gutter) var(--space-6);
    overflow-y: auto;
    background: var(--color-bg);
    border-top: 1px solid var(--color-line);
    border-right: 1px solid var(--color-line);
    box-shadow: 20px 0 40px -30px rgb(117 86 55 / 0.5);
    transform: translateX(-102%);
    visibility: hidden;
    transition: transform 0.4s var(--ease), visibility 0.4s;
  }

  .nav.is-open {
    transform: none;
    visibility: visible;
  }

  .nav__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav__link {
    display: block;
    padding-block: var(--space-4);
    font-family: var(--font-display);
    font-size: 1.6rem;
    line-height: 1.2;
    color: var(--color-brown);
    text-decoration: none;
    border-bottom: 1px solid var(--color-line);
    transition: color 0.25s var(--ease), padding-left 0.25s var(--ease);
  }

  .nav__link:hover {
    color: var(--color-sage);
    padding-left: var(--space-2);
  }

  .nav__cta { width: 100%; }

  .nav-backdrop {
    position: fixed;
    inset: var(--header-h) 0 0 0;
    z-index: 0;
    background: rgb(58 57 48 / 0.25);
    opacity: 0;
    transition: opacity 0.3s var(--ease);
  }

  .nav-backdrop.is-visible { opacity: 1; }

  @media (max-width: 760px) {
    .header__cta { display: none; }
  }

  @media (max-width: 480px) {
    .header__bar { gap: var(--space-3); }
    .brand { gap: var(--space-2); }
    .brand__mark { width: 40px; }
    .brand__name { font-size: 1rem; white-space: normal; text-wrap: balance; max-width: 11em; }
    .brand__tagline { display: none; }
    .lang { gap: 0.2rem; }
  }

  :global(html.nav-locked) { overflow: hidden; }
</style>
