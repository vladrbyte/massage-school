---
import { getContent } from "../i18n";
import SectionHeader from "./SectionHeader.astro";

const { courses, site } = getContent(Astro.url);
---

<section class="section courses" id="kurse" aria-labelledby="kurse-title">
  <div class="container">
    <SectionHeader id="kurse-title" eyebrow={courses.eyebrow} title={courses.title} lead={courses.lead} />

    <div class="filters" role="group" aria-label={site.ui.filterCourses} data-reveal>
      {courses.groups.map((g, i) => (
        <button
          class="filter"
          type="button"
          data-filter={g.id}
          aria-pressed={i === 0 ? "true" : "false"}
        >
          {g.label}
        </button>
      ))}
    </div>

    <ul class="course-grid" data-courses>
      {courses.items.map((item, i) => (
        <li class="course" data-group={item.group} data-reveal style={`--reveal-delay: ${(i % 3) * 0.06}s`}>
          <span class="course__num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
          <h3 class="course__name">{item.name}</h3>
          <p class="course__text">{item.text}</p>
          <span class="course__tag">{courses.groups.find((g) => g.id === item.group)?.label}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-filter]");
  const cards = document.querySelectorAll<HTMLElement>("[data-courses] [data-group]");

  buttons.forEach((btn) =>
    btn.addEventListener("click", () => {
      const filter = btn.dataset.filter;
      buttons.forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
      cards.forEach((card) => {
        const show = filter === "all" || card.dataset.group === filter;
        card.hidden = !show;
        if (show) card.classList.add("is-visible");
      });
    })
  );
</script>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
  }

  .filter {
    min-height: 40px;
    padding: 0 var(--space-4);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--color-text);
    font: inherit;
    font-size: var(--fs-sm);
    font-weight: 500;
    cursor: pointer;
    transition: background-color 0.25s var(--ease), color 0.25s var(--ease), border-color 0.25s var(--ease);
  }

  .filter:hover { border-color: var(--color-gold); }

  .filter[aria-pressed="true"] {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: #fff;
  }

  .course-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .course {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-6) var(--space-5) var(--space-5);
    background: #fff;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    transition: border-color 0.3s var(--ease), box-shadow 0.3s var(--ease);
  }

  .course[hidden] { display: none; }

  .course:hover {
    border-color: var(--color-gold);
    box-shadow: var(--shadow-soft);
  }

  .course__num {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 600;
    font-variant-numeric: lining-nums;
    color: var(--color-gold);
  }

  .course__name {
    font-size: 1.45rem;
    line-height: 1.15;
  }

  .course__text {
    font-size: 0.95rem;
    color: var(--color-text-muted);
  }

  .course__tag {
    align-self: flex-start;
    margin-top: auto;
    padding: 0.2rem 0.7rem;
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--color-sage);
  }

  @media (max-width: 980px) {
    .course-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 600px) {
    .course-grid { grid-template-columns: 1fr; }
    .filters {
      flex-wrap: nowrap;
      overflow-x: auto;
      margin-inline: calc(var(--gutter) * -1);
      padding-inline: var(--gutter);
      scrollbar-width: none;
    }
    .filter { flex-shrink: 0; }
  }
</style>
