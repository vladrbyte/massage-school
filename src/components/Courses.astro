---
import { getContent } from "../i18n";
import SectionHeader from "./SectionHeader.astro";

const { courses, site } = getContent(Astro.url);
const { program, catalog } = courses;
---

<section class="section courses" id="kurse" aria-labelledby="kurse-title">
  <div class="container">
    <SectionHeader id="kurse-title" eyebrow={courses.eyebrow} title={courses.title} lead={courses.lead} />

    <div class="program" data-reveal>
      <table class="program__table">
        <thead>
          <tr>
            <th scope="col" class="program__num">{program.colNum}</th>
            <th scope="col">{program.colModule}</th>
            <th scope="col" class="program__hours">{program.colHours}</th>
          </tr>
        </thead>
        <tbody>
          {program.items.map((m, i) => (
            <tr class:list={{ "is-exam": m.exam }}>
              <td class="program__num">{String(i + 1).padStart(2, "0")}</td>
              <td class="program__name">{m.name}</td>
              <td class="program__hours">{m.hours}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <header class="catalog__header" data-reveal>
      <h3 class="catalog__title">{catalog.title}</h3>
      <p class="catalog__lead">
        <span class="badge" aria-hidden="true">{catalog.inProgram}</span>
        {catalog.lead}
      </p>
    </header>

    <div class="filters" role="group" aria-label={site.ui.filterCourses} data-reveal>
      {courses.groups.map((g, i) => (
        <button
          class="filter"
          type="button"
          data-filter={g.id}
          aria-pressed={i === 0 ? "true" : "false"}
        >
          {g.label}
        </button>
      ))}
    </div>

    <ul class="course-grid" data-courses>
      {courses.items.map((item, i) => (
        <li class:list={["course", { "course--program": item.inProgram }]} data-group={item.group} data-reveal style={`--reveal-delay: ${(i % 3) * 0.06}s`}>
          <div class="course__top">
            <span class="course__num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
            {item.inProgram && <span class="badge">{catalog.inProgram}</span>}
          </div>
          <h4 class="course__name">{item.name}</h4>
          <p class="course__text">{item.text}</p>
          <span class="course__tag">{courses.groups.find((g) => g.id === item.group)?.label}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-filter]");
  const cards = document.querySelectorAll<HTMLElement>("[data-courses] [data-group]");

  buttons.forEach((btn) =>
    btn.addEventListener("click", () => {
      const filter = btn.dataset.filter;
      buttons.forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
      cards.forEach((card) => {
        const show = filter === "all" || card.dataset.group === filter;
        card.hidden = !show;
        if (show) card.classList.add("is-visible");
      });
    })
  );
</script>

<style>
  .program {
    overflow: hidden;
    margin-bottom: clamp(3.5rem, 2.5rem + 4vw, 6rem);
    background: #fff;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-soft);
  }

  .program__table {
    width: 100%;
    border-collapse: collapse;
  }

  .program__table th {
    padding: var(--space-4) var(--space-5);
    background: var(--color-surface);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-align: left;
    text-transform: uppercase;
    color: var(--color-sage);
  }

  .program__table td {
    padding: var(--space-4) var(--space-5);
    border-top: 1px solid var(--color-line);
    vertical-align: top;
  }

  .program__table tbody tr { transition: background-color 0.2s var(--ease); }
  .program__table tbody tr:hover { background: rgb(247 240 227 / 0.5); }

  .program__num {
    width: 4rem;
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 600;
    font-variant-numeric: lining-nums;
    color: var(--color-gold);
  }

  .program__table th.program__num,
  .program__table th.program__hours {
    font-family: var(--font-body);
    font-size: 0.75rem;
    color: var(--color-sage);
  }

  .program__name { line-height: 1.45; }

  .program__hours {
    width: 9rem;
    text-align: right !important;
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 600;
    font-variant-numeric: lining-nums tabular-nums;
    color: var(--color-brown);
    white-space: nowrap;
  }

  .program__table tr.is-exam td {
    background: var(--color-surface);
    font-weight: 600;
  }

  .catalog__header {
    display: grid;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
  }

  .catalog__title { font-size: var(--fs-h3); }

  .catalog__lead {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-text-muted);
  }

  .badge {
    display: inline-flex;
    align-items: center;
    padding: 0.2rem 0.7rem;
    border-radius: var(--radius-pill);
    background: var(--color-accent);
    color: #fff;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
  }

  .filter {
    min-height: 40px;
    padding: 0 var(--space-4);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--color-text);
    font: inherit;
    font-size: var(--fs-sm);
    font-weight: 500;
    cursor: pointer;
    transition: background-color 0.25s var(--ease), color 0.25s var(--ease), border-color 0.25s var(--ease);
  }

  .filter:hover { border-color: var(--color-gold); }

  .filter[aria-pressed="true"] {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: #fff;
  }

  .course-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .course {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-6) var(--space-5) var(--space-5);
    background: #fff;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    transition: border-color 0.3s var(--ease), box-shadow 0.3s var(--ease);
  }

  .course--program { border-color: rgb(95 108 76 / 0.35); }

  .course[hidden] { display: none; }

  .course:hover {
    border-color: var(--color-gold);
    box-shadow: var(--shadow-soft);
  }

  .course__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .course__num {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 600;
    font-variant-numeric: lining-nums;
    color: var(--color-gold);
  }

  .course__name {
    font-size: 1.4rem;
    line-height: 1.15;
  }

  .course__text {
    font-size: 0.95rem;
    color: var(--color-text-muted);
  }

  .course__tag {
    align-self: flex-start;
    margin-top: auto;
    padding: 0.2rem 0.7rem;
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--color-sage);
  }

  @media (max-width: 980px) {
    .course-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 600px) {
    .course-grid { grid-template-columns: 1fr; }
    .filters {
      flex-wrap: nowrap;
      overflow-x: auto;
      margin-inline: calc(var(--gutter) * -1);
      padding-inline: var(--gutter);
      scrollbar-width: none;
    }
    .filter { flex-shrink: 0; }

    .program__table th,
    .program__table td { padding: var(--space-3); }
    .program__num { width: 2.5rem; }
    .program__hours { width: auto; font-size: 1.15rem; }
    .program__table th.program__hours { font-size: 0.65rem; white-space: normal; }
  }
</style>
