---
import { getContent, withBase } from "../i18n";

const { site } = getContent(Astro.url);
const { brand, nav, contact, footer, ui } = site;
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__grid">
    <div class="footer__brand">
      <img src={withBase("/media/logo-full.jpg")} alt={brand.name} width="1079" height="405" loading="lazy" />
      <p>{footer.text}</p>
    </div>

    <nav aria-label={ui.footerNav}>
      <h2 class="footer__title">{ui.footerPage}</h2>
      <ul class="footer__list">
        {nav.map((item) => <li><a href={withBase(item.href)}>{item.label}</a></li>)}
      </ul>
    </nav>

    <div>
      <h2 class="footer__title">{ui.footerContact}</h2>
      <ul class="footer__list">
        <li>{contact.street}, {contact.zip} {contact.city}</li>
        <li><a href={contact.phoneHref}>{contact.phone}</a></li>
        <li><a href={`mailto:${contact.email}`}>{contact.email}</a></li>
        <li>{contact.hours}</li>
      </ul>
    </div>

    <div>
      <h2 class="footer__title">{ui.footerFollow}</h2>
      <ul class="footer__social">
        <li>
          <a href={contact.instagram} target="_blank" rel="noopener" aria-label="Instagram">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="0.8" fill="currentColor"/></svg>
          </a>
        </li>
        <li>
          <a href={contact.tiktok} target="_blank" rel="noopener" aria-label="TikTok">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3v11.5a3.5 3.5 0 1 1-3.5-3.5"/><path d="M14 3c.5 2.8 2.3 4.5 5 4.8"/></svg>
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="container footer__bottom">
    <p>© {year} {brand.name} · {brand.tagline}</p>
    <ul class="footer__legal">
      {footer.legal.map((l) => <li><a href={withBase(l.href)}>{l.label}</a></li>)}
    </ul>
  </div>
</footer>

<style>
  .footer {
    padding-top: var(--space-8);
    background: var(--color-bg);
    border-top: 1px solid var(--color-line);
    font-size: 0.95rem;
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1.2fr 0.8fr;
    gap: var(--space-6);
  }

  .footer__brand img {
    width: 240px;
  }

  .footer__brand p {
    margin-top: var(--space-4);
    max-width: 30ch;
    color: var(--color-text-muted);
  }

  .footer__title {
    margin-bottom: var(--space-4);
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-sage);
  }

  .footer__list {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer__list a,
  .footer__legal a {
    text-decoration: none;
    color: var(--color-text);
  }

  .footer__list a:hover,
  .footer__legal a:hover { color: var(--color-accent); text-decoration: underline; }

  .footer__social {
    display: flex;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer__social a {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--color-line);
    border-radius: 50%;
    color: var(--color-brown);
    transition: background-color 0.3s var(--ease), color 0.3s var(--ease), border-color 0.3s var(--ease);
  }

  .footer__social a:hover {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: #fff;
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-4);
    margin-top: var(--space-7);
    padding-block: var(--space-5);
    border-top: 1px solid var(--color-line);
    font-size: var(--fs-sm);
    color: var(--color-text-muted);
  }

  .footer__legal {
    display: flex;
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 900px) {
    .footer__grid { grid-template-columns: 1fr 1fr; }
    .footer__brand { grid-column: 1 / -1; }
  }

  @media (max-width: 720px) {
    .footer { padding-bottom: 80px; }
  }

  @media (max-width: 520px) {
    .footer__grid { grid-template-columns: 1fr; }
  }
</style>
