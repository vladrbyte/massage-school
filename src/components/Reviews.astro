---
import { getContent } from "../i18n";
import SectionHeader from "./SectionHeader.astro";

const { reviews } = getContent(Astro.url);
---

<section class="section section--soft reviews" id="bewertungen" aria-labelledby="bewertungen-title">
  <div class="container">
    <SectionHeader id="bewertungen-title" eyebrow={reviews.eyebrow} title={reviews.title} align="center" />

    <ul class="review-grid">
      {reviews.items.map((r, i) => (
        <li class="review" data-reveal style={`--reveal-delay: ${i * 0.1}s`}>
          <svg class="review__quote" viewBox="0 0 48 36" width="40" height="30" aria-hidden="true">
            <path fill="currentColor" d="M0 36V22C0 10 6 2.5 18 0l2 4.5C13 7 10 11 9.5 16H18v20H0zm28 0V22c0-12 6-19.5 18-22l2 4.5C41 7 38 11 37.5 16H46v20H28z" />
          </svg>
          <blockquote class="review__text">
            <p>{r.text}</p>
          </blockquote>
          <footer class="review__footer">
            <span class="review__avatar" aria-hidden="true">{r.name.charAt(0)}</span>
            <span>
              <span class="review__name">{r.name}</span>
              <span class="review__treatment">{r.treatment}</span>
            </span>
          </footer>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .review-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .review {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-6);
    background: var(--color-bg);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-line);
  }

  .review__quote { color: var(--color-gold); opacity: 0.55; }

  .review__text {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.3rem;
    line-height: 1.45;
    color: var(--color-text);
  }

  .review__footer {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-top: auto;
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-line);
  }

  .review__avatar {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--color-sage);
    color: #fff;
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 600;
  }

  .review__name {
    display: block;
    font-weight: 600;
    color: var(--color-brown);
  }

  .review__treatment {
    display: block;
    font-size: var(--fs-sm);
    color: var(--color-text-muted);
  }

  @media (max-width: 900px) {
    .review-grid { grid-template-columns: 1fr; }
  }
</style>
