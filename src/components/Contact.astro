---
import { getContent, getLang } from "../i18n";

const { site } = getContent(Astro.url);
const lang = getLang(Astro.url);
const { contactSection: cs, contact, ui } = site;
const f = cs.form;
const address = `${contact.street}, ${contact.zip} ${contact.city}`;
const routeUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(address)}`;

// Пока бэкенд для формы не выбран, endpoint пустой:
// форма проверяется и открывает почтовую программу с готовым письмом.
// Когда появится сервис отправки — вписать его URL сюда.
const FORM_ENDPOINT = "";
---

<section class="section contact" id="kontakt" aria-labelledby="kontakt-title">
  <div class="container contact__grid">
    <div class="contact__info">
      <p class="eyebrow" data-reveal>{cs.eyebrow}</p>
      <h2 id="kontakt-title" data-reveal>{cs.title}</h2>
      <p class="lead" data-reveal>{cs.lead}</p>

      <ul class="channels" data-reveal>
        <li>
          <a class="channel" href={contact.phoneHref}>
            <span class="channel__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4h3.5l1.5 4-2 1.5a11 11 0 0 0 6.5 6.5L16 14l4 1.5V19a1.5 1.5 0 0 1-1.6 1.5A16 16 0 0 1 3.5 5.6 1.5 1.5 0 0 1 5 4z"/></svg>
            </span>
            <span><span class="channel__label">{ui.phone}</span>{contact.phone}</span>
          </a>
        </li>
        <li>
          <a class="channel" href={contact.whatsapp} target="_blank" rel="noopener">
            <span class="channel__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20l1.3-3.8A8 8 0 1 1 8 19z"/><path d="M9 9.5c0 3 2.5 5.5 5.5 5.5l1-1.5-2-1-1 .8a4 4 0 0 1-1.8-1.8l.8-1-1-2z"/></svg>
            </span>
            <span><span class="channel__label">WhatsApp</span>{contact.phone}</span>
          </a>
        </li>
        <li>
          <a class="channel" href={`mailto:${contact.email}`}>
            <span class="channel__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3.5 6l8.5 7 8.5-7"/></svg>
            </span>
            <span><span class="channel__label">{ui.email}</span>{contact.email}</span>
          </a>
        </li>
      </ul>

      <div class="visit" data-reveal>
        <div>
          <h3 class="visit__title">{ui.studio}</h3>
          <address class="visit__address">{contact.street}<br />{contact.zip} {contact.city}</address>
          <a class="visit__route" href={routeUrl} target="_blank" rel="noopener">{cs.routeLabel} →</a>
        </div>
        <div>
          <h3 class="visit__title">{ui.hours}</h3>
          <p>{contact.hours}</p>
          <p class="visit__note">{contact.hoursNote}</p>
        </div>
      </div>
    </div>

    <form
      class="form"
      data-contact-form
      data-endpoint={FORM_ENDPOINT}
      data-email={contact.email}
      data-lang={lang}
      novalidate
      data-reveal
      style="--reveal-delay: .1s"
    >
      <div class="field">
        <label for="f-name">{f.name}</label>
        <input id="f-name" name="name" type="text" autocomplete="name" required />
      </div>

      <div class="field">
        <label for="f-contact">{f.contact}</label>
        <input id="f-contact" name="contact" type="text" autocomplete="email" inputmode="email" required />
      </div>

      <div class="field">
        <label for="f-interest">{f.interest}</label>
        <select id="f-interest" name="interest">
          {f.interestOptions.map((o) => <option>{o}</option>)}
        </select>
      </div>

      <div class="field">
        <label for="f-message">{f.message}</label>
        <textarea id="f-message" name="message" rows="4"></textarea>
      </div>

      <!-- ловушка для спам-ботов: люди это поле не видят -->
      <div class="hp" aria-hidden="true">
        <label for="f-website">Website</label>
        <input id="f-website" name="website" type="text" tabindex="-1" autocomplete="off" />
      </div>

      <label class="consent">
        <input type="checkbox" name="consent" required />
        <span>{f.consent} <a href="/datenschutz" hreflang="de">{f.consentLink}</a>.</span>
      </label>

      <button class="btn btn--primary form__submit" type="submit">{f.submit}</button>

      <p class="form__status" role="status" aria-live="polite" data-status hidden></p>
      <template data-msg-success>{f.success}</template>
      <template data-msg-error>{f.error}</template>
      <template data-msg-sent>{ui.formSent}</template>
      <template data-msg-failed>{ui.formFailed}</template>
      <template data-msg-subject>{ui.mailSubject}</template>
      <template data-msg-name>{ui.mailName}</template>
      <template data-msg-contact>{ui.mailContact}</template>
      <template data-msg-interest>{ui.mailInterest}</template>
    </form>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-contact-form]");

  if (form) {
    const status = form.querySelector<HTMLElement>("[data-status]")!;
    const msg = (name: string) =>
      form.querySelector<HTMLTemplateElement>(`[data-msg-${name}]`)?.content.textContent ?? "";

    const show = (text: string, kind: "ok" | "error") => {
      status.hidden = false;
      status.textContent = text;
      status.dataset.kind = kind;
    };

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const data = new FormData(form);

      // бот заполнил скрытое поле — молча выходим
      if (data.get("website")) return;

      // проверка обязательных полей
      let valid = true;
      form.querySelectorAll<HTMLInputElement>("[required]").forEach((field) => {
        const ok = field.type === "checkbox" ? field.checked : field.value.trim() !== "";
        field.closest(".field, .consent")?.classList.toggle("is-invalid", !ok);
        if (!ok) valid = false;
      });

      if (!valid) {
        show(msg("error"), "error");
        form.querySelector<HTMLElement>(".is-invalid input, .is-invalid textarea")?.focus();
        return;
      }

      const payload = {
        name: String(data.get("name")).trim(),
        contact: String(data.get("contact")).trim(),
        interest: String(data.get("interest")),
        message: String(data.get("message") ?? "").trim(),
      };

      const endpoint = form.dataset.endpoint;

      if (endpoint) {
        // настоящая отправка, когда появится сервис
        try {
          const res = await fetch(endpoint, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload),
          });
          if (!res.ok) throw new Error(String(res.status));
          show(msg("sent"), "ok");
          form.reset();
        } catch {
          show(msg("failed"), "error");
        }
        return;
      }

      // временный вариант: письмо в почтовой программе
      const subject = `${msg("subject")}: ${payload.interest}`;
      const body =
        `${msg("name")}: ${payload.name}\n${msg("contact")}: ${payload.contact}\n${msg("interest")}: ${payload.interest}\n\n${payload.message}`;
      window.location.href =
        `mailto:${form.dataset.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      show(msg("success"), "ok");
    });

    // убираем подсветку ошибки, как только человек начал исправлять
    form.addEventListener("input", (e) => {
      (e.target as HTMLElement).closest(".is-invalid")?.classList.remove("is-invalid");
    });
  }
</script>

<style>
  .contact__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: start;
  }

  .contact__info {
    display: grid;
    gap: var(--space-4);
  }

  .channels {
    display: grid;
    gap: var(--space-2);
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
  }

  .channel {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    text-decoration: none;
    font-weight: 500;
    transition: border-color 0.3s var(--ease), background-color 0.3s var(--ease);
  }

  .channel:hover {
    border-color: var(--color-gold);
    background: var(--color-surface);
  }

  .channel__icon {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--color-surface);
    color: var(--color-sage);
  }

  .channel__label {
    display: block;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .visit {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-5);
    margin-top: var(--space-4);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-line);
  }

  .visit__title {
    font-size: 1.3rem;
    margin-bottom: var(--space-2);
  }

  .visit__address { font-style: normal; }

  .visit__route {
    display: inline-block;
    margin-top: var(--space-2);
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
  }

  .visit__route:hover { text-decoration: underline; }

  .visit__note {
    margin-top: var(--space-1);
    font-size: var(--fs-sm);
    color: var(--color-text-muted);
  }

  /* Форма */
  .form {
    display: grid;
    gap: var(--space-4);
    padding: clamp(1.5rem, 1rem + 2.5vw, 2.75rem);
    background: #fff;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
  }

  .field {
    display: grid;
    gap: var(--space-2);
  }

  .field label {
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--color-brown);
  }

  .field input,
  .field select,
  .field textarea {
    width: 100%;
    min-height: 50px;
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-sm);
    background: var(--color-bg);
    color: var(--color-text);
    font: inherit;
    transition: border-color 0.2s var(--ease), box-shadow 0.2s var(--ease);
  }

  .field textarea { resize: vertical; min-height: 110px; }

  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--color-sage);
    box-shadow: 0 0 0 3px rgb(125 138 104 / 0.2);
  }

  .is-invalid input,
  .is-invalid textarea {
    border-color: #b4553f;
    box-shadow: 0 0 0 3px rgb(180 85 63 / 0.12);
  }

  .consent {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
    font-size: var(--fs-sm);
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .consent input {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    margin-top: 1px;
    accent-color: var(--color-accent);
  }

  .consent.is-invalid { color: #b4553f; }

  .consent a { color: var(--color-accent); }

  .form__submit { width: 100%; }

  .form__status {
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-sm);
    font-size: var(--fs-sm);
  }

  .form__status[data-kind="ok"] { background: #eef1e6; color: var(--color-accent-hover); }
  .form__status[data-kind="error"] { background: #f8e9e4; color: #8f3f2c; }

  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  @media (max-width: 900px) {
    .contact__grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 480px) {
    .visit { grid-template-columns: 1fr; }
  }
</style>
